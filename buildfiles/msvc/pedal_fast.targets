<?xml version="1.0" encoding="utf-8"?>
<!-- Pedal test builds: like ci_only.targets but without whole program optimization / link time code generation.
     The final link then takes about a minute instead of ~10, and the compile cache (ccache) can reuse more.
     The emulator runs a little slower without it; light gun games run fine. -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <DebugInformationFormat>None</DebugInformationFormat>
      <WholeProgramOptimization>false</WholeProgramOptimization>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>
</Project>
