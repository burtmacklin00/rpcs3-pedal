{"author":{"avatar":"https://avatars.githubusercontent.com/u/15904127?v=4","date":"2018-04-23T13:13:00Z","email":"karokidii@gmail.com","login":"kd-11","name":"kd-11"},"committer":{"avatar":"https://avatars.githubusercontent.com/u/15904127?v=4","date":"2018-04-25T16:14:36Z","email":"15904127+kd-11@users.noreply.github.com","login":"kd-11","name":"kd-11"},"msg":"gl: Improve pixel transfer code and notify on AMD driver bug\n- Readback does not work at all with float textures on AMD openGL\n  Driver throws a bogus OUT_OF_MEMORY error regardless of amount of VRAM and system RAM available","sha":"ffa62918aab98ff316ac23bc6e05438fead803fd"}
